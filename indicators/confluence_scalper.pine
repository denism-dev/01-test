//@version=5
strategy("Confluence Scalper", overlay = true, max_labels_count = 500,
     initial_capital = 10000, currency = currency.USD,
     default_qty_type = strategy.percent_of_equity, default_qty_value = 100,
     pyramiding = 0, calc_on_every_tick = true,
     commission_type = strategy.commission.percent, commission_value = 0.02,
     slippage = input.int(2, "Slippage (ticks)", minval = 0, group = "Risk Overlay"))
// calc_on_every_tick = true is required for the Intrabar evaluation mode
// below to mean anything — with it false, TradingView only recalculates a
// strategy on bar close regardless of the mode selected. Historical bars
// still can't fully reproduce tick-by-tick realtime sequencing, so treat
// Intrabar mode as a forward/live-testing option, not an equivalent
// historical backtest mode; Closed Bar mode is unaffected by this since
// confirmedOk below still gates entries to the bar-close tick only.

// =============================================================================
// Confluence Scalper
// Combines trend, momentum, volatility-squeeze, volume and price-action/
// liquidity confirmations into a single weighted score, and only fires a
// signal when the score clears a threshold AND a timing trigger occurs on
// the same bar. See docs/confluence-scalper-design.md for the full design.
//
// This is a `strategy()` script (not `indicator()`): entries and exits are
// real broker-emulated orders, so the Strategy Tester tab reports actual
// win rate, profit factor, avg win/loss and max drawdown. TP1/TP2/stop hit
// rates and BUY-vs-SELL/session breakdowns are computed manually below
// because Strategy Tester doesn't split those out on its own.
// =============================================================================

// ---------------------------------------------------------------------------
// Inputs
// ---------------------------------------------------------------------------
grpWeights = "Component Weights (sum should be ~100)"
wTrend   = input.int(20, "EMA Ribbon Trend", group = grpWeights)
wVwap    = input.int(15, "VWAP Position", group = grpWeights)
wStoch   = input.int(15, "Stochastic RSI Cross", group = grpWeights)
wMacd    = input.int(10, "MACD Histogram", group = grpWeights)
wSqueeze = input.int(15, "BB/KC Squeeze Release", group = grpWeights)
wVolume  = input.int(15, "Volume / Pressure", group = grpWeights)
wZone    = input.int(10, "Liquidity Zone + Rejection", group = grpWeights)

grpGate = "Signal Gating"
entryThreshold  = input.int(70, "Entry Score Threshold", minval = 1, maxval = 100, group = grpGate)
strongThreshold = input.int(85, "Strong Signal Score Threshold", minval = 1, maxval = 100, group = grpGate)
requireConfirmation = input.bool(true, "Require price-action confirmation (Zone OR Volume) on top of score",
     tooltip = "A high score built only from trend/momentum/squeeze components, with no volume or liquidity-zone support, is allowed through unless this is on.",
     group = grpGate)
oppositeCooldownBars = input.int(5, "Cooldown Bars vs Opposite-Direction Signal", minval = 0, group = grpGate)
sameDirCooldownBars  = input.int(3, "Cooldown Bars vs Same-Direction Signal", minval = 0,
     tooltip = "Without this, one sustained move can fire several same-direction signals that are not independent trades for statistics purposes.",
     group = grpGate)
useFastTriggers = input.bool(false, "Allow Stoch-cross / squeeze-release as timing triggers",
     tooltip = "When on, the Stoch-RSI cross and squeeze-release are also used as the same-bar timing trigger, which structurally overlaps with their own scored component (they get counted twice: once in the score, once as the trigger). Off by default so the timing trigger (EMA9 cross) is independent of the score.",
     group = grpGate)

grpEval = "Signal Evaluation"
evalMode = input.string("Closed Bar", "Evaluate on", options = ["Closed Bar", "Intrabar"],
     tooltip = "Closed Bar only evaluates signals once a bar is confirmed (no repaint, matches how the Strategy Tester fills orders). Intrabar evaluates every tick for maximum responsiveness, but a signal can appear and vanish before the bar closes.",
     group = grpEval)

grpSession = "Session Filter"
useSessionFilter = input.bool(true, "Restrict signals to high-liquidity sessions", group = grpSession)
londonSession = input.session("0700-1000", "London Session (local)", group = grpSession)
londonTz      = input.string("Europe/London", "London Timezone", group = grpSession)
nyOverlap     = input.session("0800-1100", "NY/London Overlap (local)", group = grpSession)
nyTz          = input.string("America/New_York", "NY Timezone", group = grpSession)

grpRisk = "Risk Overlay"
atrLen      = input.int(14, "ATR Length", group = grpRisk)
atrStopMult = input.float(1.2, "Stop Distance (x ATR)", group = grpRisk)
rr1         = input.float(1.5, "Take Profit 1 (R multiple)", group = grpRisk)
rr2         = input.float(2.5, "Take Profit 2 (R multiple)", group = grpRisk)
tp1QtyPct   = input.float(50, "TP1 Size (% of position)", minval = 1, maxval = 99, group = grpRisk)
allowConfluenceExit = input.bool(false, "Also exit early if confluence decays below Exit Score",
     tooltip = "Optional early exit in addition to the stop/TP bracket, not a replacement for it. Trades closed this way are tracked separately in the stats table as 'Confluence/Other'.",
     group = grpRisk)
exitThreshold = input.int(40, "Exit Score Threshold", minval = 1, maxval = 100, group = grpRisk)

grpZone = "Liquidity Zone"
pivotLen   = input.int(10, "Pivot Lookback (each side)", group = grpZone)
zoneAtrMul = input.float(0.5, "Zone Proximity (x ATR)", group = grpZone)

// ---------------------------------------------------------------------------
// 1. Trend: EMA ribbon
// ---------------------------------------------------------------------------
ema9  = ta.ema(close, 9)
ema21 = ta.ema(close, 21)
ema50 = ta.ema(close, 50)

trendBull = ema9 > ema21 and ema21 > ema50 and close > ema9
trendBear = ema9 < ema21 and ema21 < ema50 and close < ema9

// ---------------------------------------------------------------------------
// 2. VWAP position (session VWAP)
// ---------------------------------------------------------------------------
vwapVal = ta.vwap(hlc3)
vwapBull = close > vwapVal
vwapBear = close < vwapVal

// ---------------------------------------------------------------------------
// 3. Stochastic RSI cross (timing trigger)
// ---------------------------------------------------------------------------
rsiSrc = close
rsiLen = 14
stochLen = 14
smoothK = 3
smoothD = 3
rsi1 = ta.rsi(rsiSrc, rsiLen)
stochRsi = ta.stoch(rsi1, rsi1, rsi1, stochLen)
kLine = ta.sma(stochRsi, smoothK)
dLine = ta.sma(kLine, smoothD)

stochCrossUp   = ta.crossover(kLine, dLine) and kLine < 30
stochCrossDown = ta.crossunder(kLine, dLine) and kLine > 70
stochBull = kLine > dLine
stochBear = kLine < dLine

// ---------------------------------------------------------------------------
// 4. MACD histogram slope
// ---------------------------------------------------------------------------
[macdLine, signalLine, histLine] = ta.macd(close, 12, 26, 9)
macdBull = histLine > histLine[1] and (histLine > 0 or histLine > histLine[2])
macdBear = histLine < histLine[1] and (histLine < 0 or histLine < histLine[2])

// ---------------------------------------------------------------------------
// 5. BB / KC squeeze release (breakout timing trigger)
// ---------------------------------------------------------------------------
bbLen = 20
bbMult = 2.0
basis = ta.sma(close, bbLen)
dev = bbMult * ta.stdev(close, bbLen)
bbUpper = basis + dev
bbLower = basis - dev

kcMult = 1.5
rangeMa = ta.sma(ta.tr, bbLen)
kcUpper = basis + rangeMa * kcMult
kcLower = basis - rangeMa * kcMult

squeezeOn = bbLower > kcLower and bbUpper < kcUpper
squeezeReleaseUp   = squeezeOn[1] and not squeezeOn and close > bbUpper
squeezeReleaseDown = squeezeOn[1] and not squeezeOn and close < bbLower

bbWidth = (bbUpper - bbLower) / basis
squeezeBull = squeezeReleaseUp or (not squeezeOn and bbWidth > bbWidth[1] and close > basis)
squeezeBear = squeezeReleaseDown or (not squeezeOn and bbWidth > bbWidth[1] and close < basis)

// ---------------------------------------------------------------------------
// 6. Volume / pressure confirmation
// ---------------------------------------------------------------------------
volSma = ta.sma(volume, 20)
volSpike = volume > volSma * 1.5
candleRange = high - low
pressure = candleRange == 0 ? 0.5 : (close - low) / candleRange
volumeBull = volSpike and pressure > 0.66
volumeBear = volSpike and pressure < 0.33

// ---------------------------------------------------------------------------
// 7. Liquidity zone + rejection price action
// ---------------------------------------------------------------------------
atrVal = ta.atr(atrLen)
pivotLow  = ta.pivotlow(low, pivotLen, pivotLen)
pivotHigh = ta.pivothigh(high, pivotLen, pivotLen)

var float lastPivotLow = na
var float lastPivotHigh = na
if not na(pivotLow)
    lastPivotLow := pivotLow
if not na(pivotHigh)
    lastPivotHigh := pivotHigh

nearSupport    = not na(lastPivotLow) and math.abs(low - lastPivotLow) <= atrVal * zoneAtrMul
nearResistance = not na(lastPivotHigh) and math.abs(high - lastPivotHigh) <= atrVal * zoneAtrMul

bodyTop = math.max(open, close)
bodyBot = math.min(open, close)
bullPinBar  = (bodyBot - low) > (candleRange * 0.5) and close > open
bearPinBar  = (high - bodyTop) > (candleRange * 0.5) and close < open
bullEngulf  = close > open and close[1] < open[1] and close > open[1] and open < close[1]
bearEngulf  = close < open and close[1] > open[1] and close < open[1] and open > close[1]

zoneBull = nearSupport and (bullPinBar or bullEngulf)
zoneBear = nearResistance and (bearPinBar or bearEngulf)

// ---------------------------------------------------------------------------
// Confluence score
// ---------------------------------------------------------------------------
totalWeight = wTrend + wVwap + wStoch + wMacd + wSqueeze + wVolume + wZone

bullScore = (trendBull ? wTrend : 0) + (vwapBull ? wVwap : 0) + (stochBull ? wStoch : 0) +
             (macdBull ? wMacd : 0) + (squeezeBull ? wSqueeze : 0) + (volumeBull ? wVolume : 0) +
             (zoneBull ? wZone : 0)
bearScore = (trendBear ? wTrend : 0) + (vwapBear ? wVwap : 0) + (stochBear ? wStoch : 0) +
             (macdBear ? wMacd : 0) + (squeezeBear ? wSqueeze : 0) + (volumeBear ? wVolume : 0) +
             (zoneBear ? wZone : 0)

bullScorePct = totalWeight == 0 ? 0 : bullScore / totalWeight * 100
bearScorePct = totalWeight == 0 ? 0 : bearScore / totalWeight * 100

// ---------------------------------------------------------------------------
// Session filter (DST-aware: timezones, not fixed UTC offsets)
// ---------------------------------------------------------------------------
inLondon    = not na(time(timeframe.period, londonSession, londonTz))
inNyOverlap = not na(time(timeframe.period, nyOverlap, nyTz))
sessionOk = not useSessionFilter or inLondon or inNyOverlap
// London (0700-1000 local) and the NY/London overlap (0800-1100 NY local,
// i.e. mid-afternoon UK time) are non-overlapping clock windows by design,
// so a compound "both at once" case would practically never fire — the two
// tags below are mutually exclusive on purpose, not an approximation.
sessionTag = inLondon ? "London" : inNyOverlap ? "NY Overlap" : "Other"

// ---------------------------------------------------------------------------
// Timing trigger: an event on THIS bar, not just persistent state.
// Default trigger (EMA9 cross) is independent of the scored components;
// the Stoch/squeeze triggers are opt-in because they double-count with the
// score (see useFastTriggers above).
// ---------------------------------------------------------------------------
baseTimingBull = ta.crossover(close, ema9)
baseTimingBear = ta.crossunder(close, ema9)
timingBull = baseTimingBull or (useFastTriggers and (stochCrossUp or squeezeReleaseUp))
timingBear = baseTimingBear or (useFastTriggers and (stochCrossDown or squeezeReleaseDown))

confirmedOk = evalMode == "Intrabar" or barstate.isconfirmed
confirmBull = not requireConfirmation or zoneBull or volumeBull
confirmBear = not requireConfirmation or zoneBear or volumeBear

// ---------------------------------------------------------------------------
// Cooldown tracking (separate same-direction vs opposite-direction limits)
// ---------------------------------------------------------------------------
var int lastBuyBar  = na
var int lastSellBar = na

canEnter(lastSameDirBar, lastOppDirBar) =>
    sameOk = na(lastSameDirBar) or (bar_index - lastSameDirBar) >= sameDirCooldownBars
    oppOk  = na(lastOppDirBar) or (bar_index - lastOppDirBar) >= oppositeCooldownBars
    sameOk and oppOk

rawBuySignal  = confirmedOk and sessionOk and timingBull and bullScorePct >= entryThreshold and
     confirmBull and canEnter(lastBuyBar, lastSellBar) and strategy.position_size == 0
rawSellSignal = confirmedOk and sessionOk and timingBear and bearScorePct >= entryThreshold and
     confirmBear and canEnter(lastSellBar, lastBuyBar) and strategy.position_size == 0

if rawBuySignal
    lastBuyBar := bar_index
if rawSellSignal
    lastSellBar := bar_index

strongBuy  = rawBuySignal and bullScorePct >= strongThreshold
strongSell = rawSellSignal and bearScorePct >= strongThreshold
plainBuy   = rawBuySignal and not strongBuy
plainSell  = rawSellSignal and not strongSell

// ---------------------------------------------------------------------------
// Trade bookkeeping
// ---------------------------------------------------------------------------
// A market strategy.entry() doesn't fill at the signal bar's close — it
// fills at the next available price the broker emulator sees, so SL/TP
// distances must be computed from the actual fill (strategy.position_avg_
// price), not from `close` at signal time, or the realized R-multiples
// drift from the configured ones. ATR is captured at signal time (that's
// still "as observed when the setup formed") and the stop/target prices
// are computed once the position is confirmed open.
//
// Per-entry stats (direction, session, TP1/TP2/SL outcome, P&L) are
// accumulated incrementally as strategy.closedtrades grows, attributed to
// whichever entry is currently open (currentEntryIdx). This does NOT
// assume a fixed number of closed-trade rows per entry — a single logical
// trade legitimately produces two rows here (one per TP1/TP2 leg, since
// they're separate strategy.exit() calls), and this design absorbs that
// correctly instead of index-matching entries 1:1 against
// strategy.closedtrades rows.
// ---------------------------------------------------------------------------
var float stopRec   = na
var float tp1Rec     = na
var float tp2Rec     = na
var float pendingAtr = na
var string pendingDir = na
var bool bracketPlaced = true

var array<string> tradeDirArr     = array.new<string>()
var array<string> tradeSessionArr = array.new<string>()
var array<float>  entryPnlArr     = array.new<float>()
var array<bool>   entryClosedArr = array.new<bool>()
var int currentEntryIdx = -1

var int processedClosed = 0
var int tp1Count   = 0
var int tp2Count   = 0
var int slCount    = 0
var int otherCount = 0

if rawBuySignal
    strategy.entry("Long", strategy.long)
    pendingAtr := atrVal
    pendingDir := "long"
    bracketPlaced := false
    array.push(tradeDirArr, "Long")
    array.push(tradeSessionArr, sessionTag)
    array.push(entryPnlArr, 0.0)
    array.push(entryClosedArr, false)
    currentEntryIdx := array.size(tradeDirArr) - 1

if rawSellSignal
    strategy.entry("Short", strategy.short)
    pendingAtr := atrVal
    pendingDir := "short"
    bracketPlaced := false
    array.push(tradeDirArr, "Short")
    array.push(tradeSessionArr, sessionTag)
    array.push(entryPnlArr, 0.0)
    array.push(entryClosedArr, false)
    currentEntryIdx := array.size(tradeDirArr) - 1

// Place the bracket exactly once, on the first bar the fill is visible.
if not bracketPlaced and strategy.position_size != 0
    fillPrice = strategy.position_avg_price
    if pendingDir == "long"
        stopRec := fillPrice - pendingAtr * atrStopMult
        tp1Rec  := fillPrice + pendingAtr * atrStopMult * rr1
        tp2Rec  := fillPrice + pendingAtr * atrStopMult * rr2
        strategy.exit("TP1", from_entry = "Long", qty_percent = tp1QtyPct, limit = tp1Rec, stop = stopRec,
             comment_profit = "TP1", comment_loss = "SL")
        strategy.exit("TP2", from_entry = "Long", qty_percent = 100 - tp1QtyPct, limit = tp2Rec, stop = stopRec,
             comment_profit = "TP2", comment_loss = "SL")
    else
        stopRec := fillPrice + pendingAtr * atrStopMult
        tp1Rec  := fillPrice - pendingAtr * atrStopMult * rr1
        tp2Rec  := fillPrice - pendingAtr * atrStopMult * rr2
        strategy.exit("TP1", from_entry = "Short", qty_percent = tp1QtyPct, limit = tp1Rec, stop = stopRec,
             comment_profit = "TP1", comment_loss = "SL")
        strategy.exit("TP2", from_entry = "Short", qty_percent = 100 - tp1QtyPct, limit = tp2Rec, stop = stopRec,
             comment_profit = "TP2", comment_loss = "SL")
    bracketPlaced := true

// Optional early exit on confluence decay — separate from, not a substitute
// for, the price-based stop/TP bracket above. Whatever exit_comment Pine
// assigns this fill, it won't equal "TP1"/"TP2"/"SL", so it always lands
// in the Confluence/Other bucket below rather than being miscounted.
if allowConfluenceExit and confirmedOk and strategy.position_size > 0 and bullScorePct < exitThreshold
    strategy.close("Long", comment = "ConfluenceExit")
if allowConfluenceExit and confirmedOk and strategy.position_size < 0 and bearScorePct < exitThreshold
    strategy.close("Short", comment = "ConfluenceExit")

// Incrementally attribute every newly-closed row to the entry that was
// open when it closed. Runs every bar, not just on the last one.
if strategy.closedtrades > processedClosed
    for j = processedClosed to strategy.closedtrades - 1
        p   = strategy.closedtrades.profit(j)
        cmt = strategy.closedtrades.exit_comment(j)
        if currentEntryIdx >= 0 and currentEntryIdx < array.size(entryPnlArr)
            array.set(entryPnlArr, currentEntryIdx, array.get(entryPnlArr, currentEntryIdx) + p)
        if cmt == "TP1"
            tp1Count += 1
        else if cmt == "TP2"
            tp2Count += 1
        else if cmt == "SL"
            slCount += 1
        else
            otherCount += 1
    processedClosed := strategy.closedtrades
    if strategy.position_size == 0 and currentEntryIdx >= 0 and currentEntryIdx < array.size(entryClosedArr)
        array.set(entryClosedArr, currentEntryIdx, true)

// ---------------------------------------------------------------------------
// Plots
// ---------------------------------------------------------------------------
plot(ema9, "EMA 9", color = color.new(color.yellow, 0))
plot(ema21, "EMA 21", color = color.new(color.orange, 0))
plot(ema50, "EMA 50", color = color.new(color.red, 0))
plot(vwapVal, "VWAP", color = color.new(color.blue, 0))

bgcolor(squeezeOn ? color.new(color.purple, 85) : na, title = "Squeeze")

plotshape(strongBuy, title = "Strong Buy", style = shape.triangleup, location = location.belowbar,
     color = color.new(color.lime, 0), size = size.small, text = "SB")
plotshape(plainBuy, title = "Buy", style = shape.triangleup, location = location.belowbar,
     color = color.new(color.green, 30), size = size.tiny, text = "B")
plotshape(strongSell, title = "Strong Sell", style = shape.triangledown, location = location.abovebar,
     color = color.new(color.red, 0), size = size.small, text = "SS")
plotshape(plainSell, title = "Sell", style = shape.triangledown, location = location.abovebar,
     color = color.new(color.maroon, 30), size = size.tiny, text = "S")

// SL/TP levels persist for the life of the trade instead of only the entry bar.
plot(strategy.position_size != 0 ? stopRec : na, "Stop", color = color.new(color.red, 0), style = plot.style_linebr)
plot(strategy.position_size != 0 ? tp1Rec  : na, "TP1",  color = color.new(color.green, 0), style = plot.style_linebr)
plot(strategy.position_size != 0 ? tp2Rec  : na, "TP2",  color = color.new(color.green, 40), style = plot.style_linebr)

// ---------------------------------------------------------------------------
// Running MAXIMUM drawdown (not current drawdown-from-peak, which returns
// to 0% after every new equity high and would understate a strategy that
// dropped 20% and then recovered). Cross-check this against the Strategy
// Tester's own "Max Drawdown %" summary cell.
// ---------------------------------------------------------------------------
var float peakEquity = strategy.initial_capital
var float maxDrawdownPct = 0.0
peakEquity := math.max(peakEquity, strategy.equity)
drawdownNow = peakEquity > 0 ? (peakEquity - strategy.equity) / peakEquity * 100 : 0.0
maxDrawdownPct := math.max(maxDrawdownPct, drawdownNow)

// ---------------------------------------------------------------------------
// Confluence breakdown table (current bar state)
// ---------------------------------------------------------------------------
var table infoTable = table.new(position.top_right, 2, 10, border_width = 1)
if barstate.islast
    table.cell(infoTable, 0, 0, "Component", bgcolor = color.new(color.gray, 60), text_color = color.white)
    table.cell(infoTable, 1, 0, "Bull/Bear", bgcolor = color.new(color.gray, 60), text_color = color.white)
    table.cell(infoTable, 0, 1, "Trend (EMA)")
    table.cell(infoTable, 1, 1, trendBull ? "Bull" : trendBear ? "Bear" : "-")
    table.cell(infoTable, 0, 2, "VWAP")
    table.cell(infoTable, 1, 2, close == vwapVal ? "-" : vwapBull ? "Bull" : "Bear")
    table.cell(infoTable, 0, 3, "Stoch RSI")
    table.cell(infoTable, 1, 3, kLine == dLine ? "-" : stochBull ? "Bull" : "Bear")
    table.cell(infoTable, 0, 4, "MACD Hist")
    table.cell(infoTable, 1, 4, macdBull ? "Bull" : macdBear ? "Bear" : "-")
    table.cell(infoTable, 0, 5, "Squeeze")
    table.cell(infoTable, 1, 5, squeezeBull ? "Bull" : squeezeBear ? "Bear" : "-")
    table.cell(infoTable, 0, 6, "Volume")
    table.cell(infoTable, 1, 6, volumeBull ? "Bull" : volumeBear ? "Bear" : "-")
    table.cell(infoTable, 0, 7, "Zone")
    table.cell(infoTable, 1, 7, zoneBull ? "Bull" : zoneBear ? "Bear" : "-")
    table.cell(infoTable, 0, 8, "Score", bgcolor = color.new(color.gray, 70), text_color = color.white)
    table.cell(infoTable, 1, 8, str.tostring(math.round(bullScorePct)) + " / " + str.tostring(math.round(bearScorePct)),
         bgcolor = color.new(color.gray, 70), text_color = color.white)
    table.cell(infoTable, 0, 9, "Weight Sum", text_color = totalWeight == 100 ? color.gray : color.red)
    table.cell(infoTable, 1, 9, str.tostring(totalWeight), text_color = totalWeight == 100 ? color.gray : color.red)

// ---------------------------------------------------------------------------
// Backtest stats table — win rate, profit factor, avg win/loss, expectancy,
// TP1/TP2/SL/confluence-exit hit rates, BUY vs SELL, and by-session
// profitability, computed from strategy.closedtrades so these can be
// verified independently of the Strategy Tester's own summary tab.
// ---------------------------------------------------------------------------
var table statsTable = table.new(position.bottom_right, 2, 15, border_width = 1)
if barstate.islast
    // Iterate ENTRIES (each fully resolved once both its legs have closed),
    // not raw closedtrades rows — a single entry can span two rows (one
    // per TP1/TP2 leg), and win/loss should reflect the entry's combined
    // P&L, not each leg scored independently.
    totalTrades = 0
    wins = 0
    losses = 0
    sumWin = 0.0
    sumLoss = 0.0
    longCount = 0
    longWins = 0
    shortCount = 0
    shortWins = 0
    londonProfit = 0.0
    londonCount = 0
    nyProfit = 0.0
    nyCount = 0
    otherSessProfit = 0.0
    otherSessCount = 0

    for k = 0 to array.size(tradeDirArr) - 1
        isClosed = k < array.size(entryClosedArr) and array.get(entryClosedArr, k)
        if isClosed
            p    = array.get(entryPnlArr, k)
            dir  = array.get(tradeDirArr, k)
            sess = array.get(tradeSessionArr, k)

            totalTrades += 1
            if p > 0
                wins += 1
                sumWin += p
            else
                losses += 1
                sumLoss += p

            if dir == "Long"
                longCount += 1
                longWins += p > 0 ? 1 : 0
            else
                shortCount += 1
                shortWins += p > 0 ? 1 : 0

            if sess == "London"
                londonProfit += p
                londonCount += 1
            else if sess == "NY Overlap"
                nyProfit += p
                nyCount += 1
            else
                otherSessProfit += p
                otherSessCount += 1

    winRate = totalTrades > 0 ? wins / totalTrades * 100 : na
    profitFactor = sumLoss != 0 ? sumWin / math.abs(sumLoss) : na
    avgWin = wins > 0 ? sumWin / wins : na
    avgLoss = losses > 0 ? sumLoss / losses : na
    expectancy = totalTrades > 0 ? (sumWin + sumLoss) / totalTrades : na
    longWinRate = longCount > 0 ? longWins / longCount * 100 : na
    shortWinRate = shortCount > 0 ? shortWins / shortCount * 100 : na

    table.cell(statsTable, 0, 0, "Stat", bgcolor = color.new(color.gray, 60), text_color = color.white)
    table.cell(statsTable, 1, 0, "Value", bgcolor = color.new(color.gray, 60), text_color = color.white)
    table.cell(statsTable, 0, 1, "Total Trades")
    table.cell(statsTable, 1, 1, str.tostring(totalTrades))
    table.cell(statsTable, 0, 2, "Win Rate")
    table.cell(statsTable, 1, 2, na(winRate) ? "n/a" : str.tostring(math.round(winRate)) + "%")
    table.cell(statsTable, 0, 3, "Profit Factor")
    table.cell(statsTable, 1, 3, na(profitFactor) ? "n/a" : str.tostring(math.round(profitFactor * 100) / 100))
    table.cell(statsTable, 0, 4, "Avg Win / Avg Loss")
    table.cell(statsTable, 1, 4, (na(avgWin) ? "n/a" : str.tostring(math.round(avgWin * 100) / 100)) + " / " +
         (na(avgLoss) ? "n/a" : str.tostring(math.round(avgLoss * 100) / 100)))
    table.cell(statsTable, 0, 5, "Expectancy/Trade")
    table.cell(statsTable, 1, 5, na(expectancy) ? "n/a" : str.tostring(math.round(expectancy * 100) / 100))
    table.cell(statsTable, 0, 6, "Max Drawdown")
    table.cell(statsTable, 1, 6, str.tostring(math.round(maxDrawdownPct * 100) / 100) + "%")
    table.cell(statsTable, 0, 7, "TP1 / TP2 / SL Hits (legs)")
    table.cell(statsTable, 1, 7, str.tostring(tp1Count) + " / " + str.tostring(tp2Count) + " / " + str.tostring(slCount))
    table.cell(statsTable, 0, 8, "Confluence/Other Exits (legs)")
    table.cell(statsTable, 1, 8, str.tostring(otherCount))
    // Each entry normally produces two legs (TP1 + TP2 exit calls), so
    // these are rates per LEG, not per trade — they sum to ~100% across
    // the four buckets rather than being expressed against totalTrades.
    totalLegs = tp1Count + tp2Count + slCount + otherCount
    table.cell(statsTable, 0, 9, "TP1/TP2/SL/Other Rate (of legs)")
    table.cell(statsTable, 1, 9, totalLegs > 0 ?
         str.tostring(math.round(tp1Count / totalLegs * 100)) + "% / " +
         str.tostring(math.round(tp2Count / totalLegs * 100)) + "% / " +
         str.tostring(math.round(slCount / totalLegs * 100)) + "% / " +
         str.tostring(math.round(otherCount / totalLegs * 100)) + "%" : "n/a")
    table.cell(statsTable, 0, 10, "Long Trades (Win%)")
    table.cell(statsTable, 1, 10, str.tostring(longCount) + " (" + (na(longWinRate) ? "n/a" : str.tostring(math.round(longWinRate)) + "%") + ")")
    table.cell(statsTable, 0, 11, "Short Trades (Win%)")
    table.cell(statsTable, 1, 11, str.tostring(shortCount) + " (" + (na(shortWinRate) ? "n/a" : str.tostring(math.round(shortWinRate)) + "%") + ")")
    table.cell(statsTable, 0, 12, "London P/L (n)")
    table.cell(statsTable, 1, 12, str.tostring(math.round(londonProfit * 100) / 100) + " (" + str.tostring(londonCount) + ")")
    table.cell(statsTable, 0, 13, "NY Overlap P/L (n)")
    table.cell(statsTable, 1, 13, str.tostring(math.round(nyProfit * 100) / 100) + " (" + str.tostring(nyCount) + ")")
    table.cell(statsTable, 0, 14, "Other Session P/L (n)")
    table.cell(statsTable, 1, 14, str.tostring(math.round(otherSessProfit * 100) / 100) + " (" + str.tostring(otherSessCount) + ")")

// ---------------------------------------------------------------------------
// Alerts
// ---------------------------------------------------------------------------
alertcondition(strongBuy, "Strong Buy", "Confluence Scalper: Strong Buy signal")
alertcondition(plainBuy, "Buy", "Confluence Scalper: Buy signal")
alertcondition(strongSell, "Strong Sell", "Confluence Scalper: Strong Sell signal")
alertcondition(plainSell, "Sell", "Confluence Scalper: Sell signal")
